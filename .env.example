# Data Monitoring Platform Backend Environment Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# Database Configuration (Supports SQLite out of the box or PostgreSQL)
# For SQLite (default, zero configuration needed):
DATABASE_URL=sqlite:///./data_monitoring.db

# If using PostgreSQL instead, uncomment and configure:
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=data_monitoring_db
# DB_USER=postgres
# DB_PASSWORD=your_password

# Authentication / JWT
JWT_SECRET=dmp-enterprise-secret-key-6f81a7d890b2401f8d93e8271a3962b5
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:4321,http://127.0.0.1:4321,http://localhost:3000,http://127.0.0.1:3000
